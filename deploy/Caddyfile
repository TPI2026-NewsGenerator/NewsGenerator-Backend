# The site of NewsGenerator: the page (the client built by deploy.sh, in /srv) and its API on the same
# address, so the session cookie is of the site (see services/utils/jwt.js). Reached through the
# tunnel of Cloudflare (compose.yml), which ends the https: nothing listens on the internet here.
{
	auto_https off
	# the tunnel and the local network are private addresses: the address of the reader and the
	# https they forward are kept for the API (rate limits, Secure cookie)
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# The whole site behind the password of the site, before the accounts of the app (web.env, see
	# compose.yml): nobody else reaches the signup. Caddy asks the API before each request
	# (services/utils/site-gate.js): without the cookie the password gives, the API answers its page
	# of the password, sent instead of what was asked; the form of that page is open. The browser
	# asked the password before (basic_auth): an iPhone asked it again for each font and script of the
	# page, 15 times, and forgot it when Safari closed
	# What a shared link shows: the robots of the previews (WhatsApp, iMessage, Slack, Discord...) get
	# the page and its pictures without the password, never the API. The page holds no data, a robot
	# named falsely reaches nothing more
	@locked {
		not path /api/gate /og-image.png /favicon.ico /favicon-*.png /apple-touch-icon.png /icon-*.png /site.webmanifest
		not {
			header_regexp preview User-Agent (?i)(facebookexternalhit|facebot|twitterbot|slackbot|slack-imgproxy|discordbot|telegrambot|whatsapp|linkedinbot|skypeuripreview|redditbot|applebot|iframely|embedly|pinterestbot|mastodon)
			not path /api/*
		}
	}
	forward_auth @locked api:3001 {
		uri /api/gate/check
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	# the files of a build are named by their content: kept a year; the page itself asked each time
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		header Cache-Control "no-cache"
		# the routes of the app (/briefing, /profile...) are the page
		try_files {path} /index.html
		file_server
	}
}
