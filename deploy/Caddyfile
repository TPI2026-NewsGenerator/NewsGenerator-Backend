# The site of NewsGenerator: the page (the client built by deploy.sh, in /srv) and its API on the same
# address, so the session cookie is of the site (see services/utils/jwt.js). Reached through the
# tunnel of Cloudflare (compose.yml), which ends the https: nothing listens on the internet here.
{
	auto_https off
	# the tunnel and the local network are private addresses: the address of the reader and the
	# https they forward are kept for the API (rate limits, Secure cookie)
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Open to the internet: the data is behind the accounts of the app, and no account is made unless
	# SIGNUP_OPEN=1 (api.env, see services/utils/account-rules.js). A password of the whole site came
	# before: basic_auth, that an iPhone asked again for each font and script of the page, then a page of
	# its own with a cookie; a friend still had trouble getting in, and both were taken out (9.10.2026)

	# ?: only when the API gave none, so the original of an e-mail keeps its own no-referrer
	# (controllers/briefing-controller.js): its address is its key, an article opened from it never sees it
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	# The documentation (pnpm run docs:build, sent by deploy.sh to ~/newsgenerator/docs-dist), static
	# and public, on /docs. Mounted as /srv-docs/docs so that no prefix is stripped: the redirects of a
	# folder to its slash keep /docs. Asked again each time (its files keep their names from a build to
	# the next)
	@docs path /docs /docs/*
	handle @docs {
		root * /srv-docs
		header Cache-Control "no-cache"
		file_server
	}

	# The files of a build are named by their content: kept a year, by the browser and by Cloudflare;
	# the page itself asked each time. Only a file sent (2xx): the 401 of the password of the site was
	# kept a year by Cloudflare for a font, whose name never changes, and asked the password of every
	# reader whose briefing needed it long after it was taken out (10.10.2026). A file of the build that
	# is not there is not found, never the page in its place, kept a year as a font
	@assets path /assets/*
	header @assets {
		Cache-Control "public, max-age=31536000, immutable"
		match status 2xx
	}

	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		# the routes of the app (/briefing, /profile...) are the page
		try_files {path} /index.html
		file_server
	}
}
