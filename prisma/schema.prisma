generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id                             Int                              @id(map: "categories_list_pkey") @default(autoincrement())
  category_name                  String                           @unique(map: "u_categories_list")
  custom_searches_has_categories custom_searches_has_categories[]
}

model custom_searches {
  id                             Int                              @id @default(autoincrement())
  id_user                        Int
  title                          String
  language                       String
  timeframe                      String
  keyword                        String
  users                          users                            @relation(fields: [id_user], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_id_user")
  custom_searches_has_categories custom_searches_has_categories[]

  @@unique([id_user, title], map: "u_custom_searches")
}

model custom_searches_has_categories {
  id               Int             @id @default(autoincrement())
  id_custom_search Int
  id_category      Int
  categories       categories      @relation(fields: [id_category], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_category")
  custom_searches  custom_searches @relation(fields: [id_custom_search], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_custom_search")

  @@unique([id_custom_search, id_category], map: "u_custom_searches_has_categories")
}

model roles {
  id    Int     @id(map: "roles_list_pkey") @default(autoincrement())
  role  String  @unique(map: "u_roles_list")
  users users[]
}

model user_feeds {
  id         Int      @id @default(autoincrement())
  id_user    Int
  url        String
  site       String
  category   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  // 'user' when added by hand, 'profile' when found for the profile (removed once it brings nothing on it)
  origin     String   @default("user")
  language   String?
  // a source added by hand the reader trusts (db/add_trusted_sources.sql)
  trusted    Boolean  @default(false)
  // a source added by hand the reader shares: it can be suggested to the others (db/add_source_growth.sql)
  shared     Boolean  @default(false)
  users      users    @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_feeds_user")

  @@unique([id_user, url], map: "u_user_feeds")
  @@index([id_user], map: "i_user_feeds_user")
  @@index([url], map: "i_user_feeds_url")
}

model users {
  id                Int                 @id @default(autoincrement())
  username          String
  email             String
  password          String
  role              Int
  custom_searches   custom_searches[]
  user_feeds        user_feeds[]
  user_profiles     user_profiles?
  profile_interests profile_interests[]
  briefings         briefings[]
  roles             roles               @relation(fields: [role], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_id_role")

  @@unique([username, email], map: "u_users")
}

model feeds {
  id              Int        @id @default(autoincrement())
  url             String     @unique(map: "u_feeds")
  etag            String?
  last_modified   String?
  last_fetched_at DateTime?  @db.Timestamptz(6)
  last_error      String?
  articles        articles[]
}

model articles {
  id            Int                               @id @default(autoincrement())
  id_feed       Int
  link          String
  title         String
  description   String                            @default("")
  thumbnail     String?
  category      String[]                          @default([])
  published_at  DateTime?                         @db.Timestamptz(6)
  created_at    DateTime                          @default(now()) @db.Timestamptz(6)
  topic         String?
  summary       String?
  sourcing      String?
  // generated by Postgres (db/add_articles_search.sql), never written by the app
  search_text   String?                           @default(dbgenerated("article_search_text(title, description, category)"))
  // bge-m3 vectors (pgvector), written and compared in SQL only (db/add_briefing.sql, models/story-model.js)
  lang          String?
  title_dense   Unsupported("vector(1024)")?
  title_sparse  Unsupported("sparsevec(250002)")?
  text_dense    Unsupported("vector(1024)")?
  text_sparse   Unsupported("sparsevec(250002)")?
  embedded_at   DateTime?                         @db.Timestamptz(6)
  id_story      Int?
  // generated by Postgres (db/add_briefing.sql), never written by the app
  medium        String?                           @default(dbgenerated("medium_of(link)"))
  title_figures String[]                          @default(dbgenerated("figures_of(title)"))
  feeds         feeds                             @relation(fields: [id_feed], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_id_feed")
  stories       stories?                          @relation(fields: [id_story], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_articles_story")

  @@unique([id_feed, link], map: "u_articles")
  @@index([created_at], map: "i_articles_created_at")
  @@index([search_text(ops: raw("gin_trgm_ops"))], map: "i_articles_search_text", type: Gin)
  @@index([id_story], map: "i_articles_story")
}

// the articles of several media telling the same news (db/add_briefing.sql)
model stories {
  id         Int        @id @default(autoincrement())
  lang       String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  articles   articles[]

  @@index([updated_at], map: "i_stories_updated_at")
}

model user_profiles {
  id_user          Int       @id
  text             String
  topics           String[]  @default([])
  languages        String[]  @default([])
  discovery_status String    @default("idle")
  discovery_error  String?
  discovered_at    DateTime? @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  // feeds kept by the reader after their thumbs left them out (db/add_trusted_sources.sql)
  kept_sources     String[]  @default([])
  users            users     @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_profiles_user")
}

model profile_interests {
  id       Int                               @id @default(autoincrement())
  id_user  Int
  position Int
  text     String
  weight   Float                             @default(1) @db.Real
  keywords String                            @default("")
  searches String[]                          @default([])
  sections String[]                          @default([])
  category String?
  // pgvector, written and read in SQL only (models/profile-model.js)
  dense    Unsupported("vector(1024)")?
  sparse   Unsupported("sparsevec(250002)")?
  users    users                             @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profile_interests_user")

  @@index([id_user], map: "i_profile_interests_user")
}

model briefings {
  id          Int       @id @default(autoincrement())
  id_user     Int
  status      String    @default("running")
  step        String?
  error       String?
  items       Json      @default("[]")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)
  users       users     @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_briefings_user")

  @@index([id_user, created_at(sort: Desc)], map: "i_briefings_user")
}
