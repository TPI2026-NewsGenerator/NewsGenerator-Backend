generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id                             Int                              @id(map: "categories_list_pkey") @default(autoincrement())
  category_name                  String                           @unique(map: "u_categories_list")
  custom_searches_has_categories custom_searches_has_categories[]
}

model custom_searches {
  id                             Int                              @id @default(autoincrement())
  id_user                        Int
  title                          String
  language                       String
  timeframe                      String
  keyword                        String
  users                          users                            @relation(fields: [id_user], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_id_user")
  custom_searches_has_categories custom_searches_has_categories[]

  @@unique([id_user, title], map: "u_custom_searches")
}

model custom_searches_has_categories {
  id               Int             @id @default(autoincrement())
  id_custom_search Int
  id_category      Int
  categories       categories      @relation(fields: [id_category], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_category")
  custom_searches  custom_searches @relation(fields: [id_custom_search], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_custom_search")

  @@unique([id_custom_search, id_category], map: "u_custom_searches_has_categories")
}

model roles {
  id    Int     @id(map: "roles_list_pkey") @default(autoincrement())
  role  String  @unique(map: "u_roles_list")
  users users[]
}

model users {
  id              Int               @id @default(autoincrement())
  username        String
  email           String
  password        String
  role            Int
  custom_searches custom_searches[]
  roles           roles             @relation(fields: [role], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_id_role")

  @@unique([username, email], map: "u_users")
}
