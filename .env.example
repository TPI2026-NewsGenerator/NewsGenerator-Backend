OLLAMA_API_KEY=your_ollama_api_key
# optional: the model of the AI (default gemma4:31b), and an Ollama server of our own instead of
# Ollama cloud (then no key is needed), e.g. http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_HOST=
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
ACCESS_TOKEN_SECRET=a-string-secret-at-least-256-bits-long
PORT=3001
# optional, RSS cache: the news older than this are deleted
FEED_RETENTION_DAYS=30

# RSS-Bridge: builds a feed out of the news sites that publish none (goal.com, onefootball.com).
# Start it with "docker compose up -d", see docker-compose.yml. Leave it empty to work without:
# those sites are then simply out of reach, nothing else changes.
RSS_BRIDGE_URL=http://127.0.0.1:3002

# The embedder: bge-m3 vectors (dense + sparse) of the news and the profiles, see embedder/server.py.
# Start it with "pnpm run embedder" (Python, FlagEmbedding). Without it the news are still stored,
# they get their vectors once it answers; the profiles and the briefing need it.
EMBEDDER_URL=http://127.0.0.1:8020
# optional, an embedder on another machine (a graphics card, see embedder/server.py): its address in
# EMBEDDER_URL, the secret it was given (same EMBEDDER_TOKEN, 32+ characters), and bigger batches
EMBEDDER_TOKEN=
EMBEDDER_BATCH=16

# optional, background work (see services/ingest-service.js): every feed read, the new news embedded
# and grouped into stories. INGEST_IN_SERVER=false leaves it to "pnpm run ingest" run by a scheduler
INGEST_IN_SERVER=true
INGEST_INTERVAL_MINUTES=20
INGEST_MAX_EMBEDDED=300
