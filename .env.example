OLLAMA_API_KEY=your_ollama_api_key
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
ACCESS_TOKEN_SECRET=a-string-secret-at-least-256-bits-long
PORT=3001
# optional, RSS cache
FEED_MAX_AGE_MINUTES=30
FEED_RETENTION_DAYS=30

# RSS-Bridge: builds a feed out of the news sites that publish none (goal.com, onefootball.com).
# Start it with "docker compose up -d", see docker-compose.yml. Leave it empty to work without:
# those sites are then simply out of reach, nothing else changes.
RSS_BRIDGE_URL=http://127.0.0.1:3002
