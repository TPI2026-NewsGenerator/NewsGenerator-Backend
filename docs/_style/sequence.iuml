' Style shared by the sequence diagrams of sprint 4. A participant is an ES module of the server:
' its messages are the functions called, in the order of the code.
skinparam shadowing false
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #C9B458
skinparam sequence {
    ParticipantBackgroundColor #FFFFFF
    ParticipantBorderColor #555555
    DatabaseBackgroundColor #F2F2F2
    DatabaseBorderColor #888888
    LifeLineBorderColor #999999
    ArrowColor #555555
    GroupBorderColor #7A93B8
    GroupBackgroundColor #EEF3FA
    BoxBorderColor #CCCCCC
}
autonumber
hide footbox
