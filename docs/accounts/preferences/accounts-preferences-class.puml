@startuml accounts-preferences-class
!include ../../_style/class.iuml
left to right direction
title Accounts > Preferences — the display preferences, in the browser and on the account

package "Client (React)" as Client {
    class AuthProvider {
        + startPreferences(userId)
        + endPreferences()
    }
    class usePreference {
        + usePreference(definition)
    }
    class preferences {
        + preference({name, key, fallback, parse, serialize})
        + startPreferences(userId)
        + endPreferences()
        - flush()
        - reconcile(definition)
    }
    class "the six preferences" as Six {
        layout, mailPresets, pagePresets
        show, format, aiFirst, size, followingNews
        + kept*() / keep*()
        + usePresets(scope)
    }
    class PreferencesApi {
        + get()
        + save(changes)
    }
}
note bottom of preferences
    The browser answers at once (localStorage).
    The account, read once after the sign-in, wins;
    what it has none of goes up. Each change goes
    up after 800 ms. A failed call is silent
end note
package "Presentation" {
    class accountRouter {
        + GET /account/preferences
        + PUT /account/preferences
    }
    class accountController {
        + preferences()
        + savePreferences()
    }
}
note right of accountRouter
    authenticateToken, then a counter per account
    and per route: 60 reads, 200 saves in 10 minutes
end note
package "Business" {
    class accountService {
        + preferences(userId)
        + savePreferences(userId, body)
    }
}
package "utils" {
    class preferencesRules {
        + checkedPreferences(body)
        + PREFERENCES
    }
    class rateLimit {
        + rateLimit()
    }
    class jwt {
        + authenticateToken()
    }
}
note right of preferencesRules
    A whitelist: only these keys, only the values
    the page offers, 4096 bytes at most
    (400 with the rule, 413)
end note
package "Data" {
    class userModel {
        + preferences(id)
        + mergePreferences(id, changes)
    }
}
class "PostgreSQL\n(users.preferences jsonb)" as PostgreSQL <<external>>
class "localStorage" as LocalStorage <<external>>

AuthProvider --> preferences
Six --> preferences
Six --> usePreference
usePreference --> preferences
preferences --> LocalStorage
preferences --> PreferencesApi
PreferencesApi --> accountRouter
accountRouter --> jwt
accountRouter --> rateLimit
accountRouter --> accountController
accountController --> accountService
accountService --> preferencesRules
accountService --> userModel
userModel --> PostgreSQL
@enduml
