@startuml 20-signup-sequence
!include ../_style/sequence.iuml
title Sign up — the account and its first profile at once

actor Reader
participant "Client (React)" as Client
participant "profileRouter\n+ funnelAccess" as ProfileRouter
participant "signupRouter\n+ whileOpen, rateLimit" as Router
participant signupController as Controller
participant signupService as Signup
participant profileService as Profile
participant "profileFunnel\nprofileAi" as AI
participant embedder as Embedder
participant userModel as UserModel
participant profileModel as ProfileModel
participant discoveryService as Discovery
database "PostgreSQL" as DB

Client -> ProfileRouter : GET /profile/options
ProfileRouter --> Client : {languages, signup: signupOpen()}
alt signup false (SIGNUP_OPEN is not 1)
    note over Client : the page says account creation is closed;\nthe funnel would ask for a session too
end

group the profile written with the AI, nothing saved
    Reader -> Client : a few words of what they want to read
    loop up to 3 rounds
        Client -> ProfileRouter : POST /profile/funnel/questions {start, rounds, language}
        ProfileRouter -> Profile : funnelQuestions(asked)
        Profile -> AI : nextQuestions(funnel)
        AI -> AI : gemma4:31b (Ollama)
        AI --> Client : {enough, questions}: 2 to 4,\neach with choices to tick
        Reader -> Client : ticks, writes their own words
    end
    Client -> ProfileRouter : POST /profile/funnel/text
    ProfileRouter -> Profile : funnelText(asked)
    Profile -> AI : writeProfile(funnel)
    AI --> Client : {text}: the profile in the first person
    Reader -> Client : reads it, changes it if they want
    note right of ProfileRouter
        Open to anyone only while SIGNUP_OPEN=1;
        40 calls per address and hour
    end note
end

Reader -> Client : name, email, password, language
Client -> Router : POST /signup {username, email, password, text, language}
alt SIGNUP_OPEN is not 1
    Router --> Client : 403 "Account creation is closed."
else more than 5 signups from this address in an hour
    Router --> Client : 429 {error, retryAfter}
end
Router -> Controller : register(req)
Controller -> Signup : register({username, email, password, text, language})
Signup -> Signup : isUsername, isEmail, isPassword\n(10 characters to 72 bytes)
Signup -> UserModel : taken(name, email)
UserModel -> DB : SELECT users, whatever the case
alt taken
    Signup --> Controller : 409
end

group the profile read before the account is created
    Signup -> Profile : prepare({text, language})
    Profile -> Profile : 20 to 3000 characters,\none of the languages
    Profile -> AI : interestsOf({text, language, categories})
    AI -> AI : gemma4:31b (Ollama), asked once again\nwhen words of the text are in no interest
    AI --> Profile : interests (keywords, sections,\nGoogle News searches), what is refused
    alt no interest in the text
        Profile --> Signup : 422
        Signup --> Controller : 422, no account left behind
    end
    Profile -> Embedder : embed(the texts of the interests)
    Embedder --> Profile : dense + sparse vectors (bge-m3)
    Profile --> Signup : {profile, interests}
end

Signup -> UserModel : roleId('User')
Signup -> Signup : hashWithSalt(password) (bcrypt, 12 rounds)
Signup -> UserModel : create(user)
UserModel -> DB : INSERT users
alt taken meanwhile (unique index, isTaken)
    Signup --> Controller : 409
end
Signup -> Profile : store(userId, null, prepared)
Profile -> ProfileModel : save(userId, null, profile, interests)
ProfileModel -> DB : INSERT user_profiles (named "Profil"),\nthen profile_interests + their vectors
Profile -> Discovery : start(profileId)
Discovery -> ProfileModel : setDiscovery(profileId, 'running')
note right of Discovery
    The sources are looked for in
    background, see 23-discovery-sequence
end note
alt the profile could not be stored
    Signup -> UserModel : delete(userId)
    note right of Signup : the name must not stay taken\nby an account without profile
    Signup --> Controller : the error: 500
end
Signup -> Signup : generateAccessToken(user) (JWT, 7 days)
Signup --> Controller : {id_user, token}
Controller -> Controller : startSession(res, token):\nHttpOnly cookie "session"
Controller --> Client : 201 {id_user}, signed in at once
Client -> Client : GET /session {id, username, email,\nrole, admin}, then the Profile page
note over Controller
    An error of the server (500) is not described
    to the client: anyone can call this route
end note
@enduml
