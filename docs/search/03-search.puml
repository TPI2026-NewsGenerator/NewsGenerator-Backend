@startuml 03-search
!include ../_style/class.iuml
title Search — words or a sentence, answered from the cache

class EndUser
package "Presentation" {
    class newsRouter {
        + POST /news
        + GET /news/categories
        + POST /news/translations
        + POST /news/summary
    }
    class newsController {
        + getNews()
        + getCategories()
        + translateNews()
        + getNewsSummary()
    }
}
package "Who asks" as Who {
    class jwt {
        + authenticateToken()
    }
    class activeProfile {
        + activeProfile()
    }
}
note right of Who
    The profile of the header X-Profile
    when it is one of the user's,
    else their first one
end note
package "Business" {
    class newsService {
        + getNews()
        + searchByMeaning()
        + translateNews()
        + cachedArticles()
        + summarizeStories()
    }
    class feedService <<other feature>> {
        + languages()
        + categories()
    }
    class ingestService <<other feature>> {
        + searchesOfCategories()
        + sentenceFeeds()
        + readNow()
    }
}
note left of newsService
    Reads the news of every language and
    shows the cards in the one chosen: the
    shared feeds of the categories, the
    sources of the profile, those of every
    other reader (but an address that may
    hold a key), the Google News searches
    of the profiles and of the sentences
    searched before, and the directory.
    A link not in the cache is refused (400).
end note
package "Data" as Data {
    class feedModel {
        + userFeedUrls()
        + publicFeedUrls()
        + searchArticles()
        + closestArticles()
        + similarArticlePairs()
        + closeCardPairs()
        + threadArticles()
        + getArticlesByLinks()
        + trustedMedia()
        + saveResolvedLinks()
        + saveExtract()
        + saveTranslation()
    }
    class directoryModel <<other feature>> {
        + feedUrls()
    }
    class profileModel <<other feature>> {
        + idsOf()
        + searchesOf()
    }
}
package "Finding the news" as Finding {
    class links {
        + getAllLanguagesLinks()
    }
    class filter {
        + hasOperators()
        + parse()
        + canWiden()
        + widen()
        + toKeywords()
        + matcher()
    }
    class embedder {
        + embed()
    }
    class searchAi {
        + sortByMeaning()
    }
    class googleNews {
        + sentenceUrl()
        + googleAvailable()
        + decodeLinks()
    }
}
note bottom of Finding
    Words with an operator: SQL on the cache.
    A sentence: the closest news by their
    vectors, the AI says which ones answer.
    Every sentence is asked to Google News;
    under 5 answers it is searched again
    with its news.
end note
package "Building the cards" as Cards {
    class grouping {
        + averageLink()
        + unionFind()
    }
    class profileAi <<other feature>> {
        + mergeStories()
    }
    class hedging {
        + hedgedBy()
    }
    class language {
        + languageOf()
        + writtenIn()
    }
}
note bottom of Cards
    One card per story, the cards of one fact
    joined by the AI (a sentence only), one
    card per thread. How many media and
    wordings, never a verdict.
end note
package "Reading the cards chosen" as Reading {
    class readingOrder {
        + readingOrder()
        + onceEach()
    }
    class crawlers {
        + Html()
    }
    class extract {
        + extractArticle()
        + translationFor()
        + translateTexts()
    }
    class contested {
        + contestedOf()
    }
    class corroboration {
        + corroborationOf()
    }
}
note bottom of Reading
    10 cards at most, 5 articles each, a
    trusted medium first. The AI picks the
    sentences, copied word for word, saved.
end note
class ollama {
    + ollamaJson()
}
class "Ollama (gemma4:31b)" as Ollama <<external>>
class "Embedder (bge-m3)" as Embedder <<external>>
class "Google News" as GoogleNewsApi <<external>>
class "PostgreSQL + pgvector" as PostgreSQL <<external>>

jwt -[hidden]down- activeProfile
links -[hidden]down- filter
filter -[hidden]down- embedder
embedder -[hidden]down- searchAi
searchAi -[hidden]down- googleNews
grouping -[hidden]down- profileAi
profileAi -[hidden]down- hedging
hedging -[hidden]down- language
readingOrder -[hidden]down- crawlers
crawlers -[hidden]down- extract
extract -[hidden]down- contested
contested -[hidden]down- corroboration

EndUser --> newsRouter
newsRouter --> jwt
newsRouter --> activeProfile
activeProfile --> profileModel
newsRouter --> newsController
newsController --> newsService
newsController --> feedService
newsService --> ingestService
newsService --> Data
newsService --> Finding
newsService --> Cards
newsService --> Reading
ingestService --> profileModel
searchAi --> ollama
profileAi --> ollama
extract --> ollama
contested --> ollama
ollama --> Ollama
embedder --> Embedder
googleNews --> GoogleNewsApi
Data --> PostgreSQL
@enduml
