@startuml
title Récupération de la recherche personnalisée (Backend)
autonumber

participant "Client (App)" as Client
participant "Router" as Router
participant "Controller" as Controller
participant "Service" as Service
participant "Model" as Model
database "Storage (DB)" as Storage


Client -> Router : GET /customsearch (cookie "session")
Router -> Router : authenticateToken()
alt pas de session, ou une session expirée\nou ouverte avant le dernier changement de mot de passe
    Router --> Client : HTTP 403
end
Router -> Controller : getUserCustomSearch(req)
note right of Controller : l'id de l'utilisateur vient du token vérifié,\njamais de la requête
Controller -> Service : getUserCustomSearch(userId)
Service -> Model : getUserCustomSearch(userId)
Model -> Storage : SELECT users + custom_searches + leurs categories
Storage --> Model : data_results
Model --> Service : data_results
Service -> Service : {id, title, keyword, language,\ntimeframe, category[]}
Service --> Controller : custom_search_data
Controller --> Client : HTTP 200 (custom_search_data)

@enduml
