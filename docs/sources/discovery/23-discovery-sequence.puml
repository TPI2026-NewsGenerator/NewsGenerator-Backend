@startuml 23-discovery-sequence
!include _sequence.iuml
title Discovery — the sources found for the interests of a profile

participant "profileService\n(signup, profile saved,\nfind again) or\nserver start" as Profile
participant discoveryService as Discovery
participant "profileModel\n+ feedModel" as Models
participant "sourceService\n+ feedbackService" as Known
participant googleNews as Google
participant mediaCloud as MC
participant "feedFinder\n+ meaningJudge" as Finder
participant profileAi as AI
participant ingestService as Ingest
database "PostgreSQL" as DB

Profile -> Discovery : start(profileId)
Discovery -> Models : setDiscovery('running')
Discovery -->> Profile : returns at once
note over Discovery
    Asked again while it runs, it runs once
    more after, with the profile as it is then.
    A restart: resumeInterrupted() starts the
    ones still 'running' again
end note

group discover(profileId), phase 'google'
    Discovery -> Discovery : prune(): the feeds found with no news on\nthe profile in 14 days removed, the kept\nand trusted ones aside
    Discovery -> Models : interestsForDiscovery, userFeedUrls,\ncountUserFeeds('profile')
    Models -> DB : the interests with their vectors,\nnot the ones of a project
    alt no room (60 feeds for the profile)
        Discovery -> Discovery : no medium looked for, nothing read
    end
    Discovery -> Known : FeedbackService.of, removedSources,\nknownMedia(their feeds + refused + removed)
    note right : only new media are looked for
    Discovery -> Finder : judgeOf(the vectors of the interests)
    opt Media Cloud on
        Discovery ->> MC : mediaFor(pressSearches(...)) of every interest
        note right of MC
            asked at once: its queue waits
            (2 searches a minute) while Google
            is tried
        end note
    end

    loop each interest
        loop each search of the interest
            Discovery -> Google : search(q, 7 days, language)
            Google --> Discovery : the media that wrote on it
        end
        loop tryPerLanguage: the new media, 2 kept or 5 tried per language, 3 at a time
            Discovery -> Finder : findFeeds(site, subject, judge)
            Finder --> Discovery : its feed most on the subject, or none
            opt 2 of its last 30 news on an interest
                Discovery -> AI : confirmOnSubject(interests, 12 titles)
                AI --> Discovery : the titles on the interests
                note right : kept on 2 confirmed; the AI\nnot answering keeps the feed
            end
        end
    end
    Discovery -> Discovery : allocate among the interests,\nwithinBridgeRoom, 20 at most
    Discovery -> Models : addProfileFeeds(feeds)
    Models -> DB : user_feeds, origin 'profile'
    Discovery ->> Ingest : run({urls: the new feeds +\nsearchesOfUser(profileId)})
    note right of Ingest
        read and embedded at once,
        while the press is looked for
    end note
end

group phase 'press' (Media Cloud on)
    loop each interest
        MC -->> Discovery : the press media and their news
        loop the media only Media Cloud named: 2 kept or 3 tried per language
            Discovery -> MC : knownFeeds(site)
            Discovery -> Finder : findFeeds(site, subject, judge, known)
            Discovery -> AI : confirmOnSubject(...)
        end
    end
    Discovery -> Discovery : allocate, the room left
    Discovery -> Models : addProfileFeeds(feeds)
    Discovery ->> Ingest : run({urls: the new feeds})
end

Discovery -> Ingest : waits for the reads
alt done
    Discovery -> Models : setDiscovery('done')
else an error
    Discovery -> Models : setDiscovery('failed', message)
end
@enduml
