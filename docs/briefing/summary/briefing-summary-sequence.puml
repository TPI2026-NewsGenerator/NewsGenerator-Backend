@startuml briefing-summary-sequence
!include ../../_style/sequence.iuml
title Briefing > Summary — made with the key passages, chosen on the page and for the e-mail

actor Reader
participant "BriefingPage\n+ BriefingFormat" as Page
participant "formats.js" as Formats
participant BriefingCard as Card
participant MailBar as Mail
participant "briefingController" as Controller
participant briefingService as Briefing
participant extract as Extract
participant briefingMail as BriefingMail
database "PostgreSQL" as DB

== Step "summarizing" (see Key passages) ==
Briefing -> Extract : extractArticle(title, page, {language})
Extract -> Extract : the AI's numbers (one call, gemma4:31b)
Extract -> Extract : shorterWays(sentences, picked)
note right : digest: kept while they fit 65 words,\nthe first always; back in the order\nof the article
opt a translation of the passages
    Extract -> Extract : digestTranslation: the same sentences\ntaken from it, no other call
end
Extract --> Briefing : {digest, digestTranslation, ...}
Briefing -> DB : items: digest, digestTranslation (passagesText)

== Read ==
Page -> Formats : keptFormat(): localStorage, 'passages' by default
Reader -> Page : "Read as: Summary"
Page -> Formats : keepFormat('digest')
Page -> Card : format 'digest'
Card -> Formats : fieldsOf(item, 'digest')
alt the card has a digest
    Card --> Reader : one paragraph, "[…]" where sentences were skipped,\ntranslated or as published
else a briefing written before 12.10.2026
    Card --> Reader : its key passages
end

== Sent by e-mail ==
Reader -> Mail : "Send email": "In the e-mail, as" preset to 'digest'
Mail -> Controller : POST /briefing/:id/email {storyIds, format: 'digest', ai?}
Controller -> Briefing : email(..., format, ai)
Briefing -> Briefing : format in MAIL_FORMATS, else 400
Briefing -> BriefingMail : briefingMail(briefing, {format: 'digest'})
BriefingMail -> BriefingMail : wayOf(card, 'digest'): digestTranslation or digest,\nthe AI summary for a card of 'ai'
BriefingMail --> Briefing : html + text, "Summary" above each card
Controller --> Mail : 204
@enduml
