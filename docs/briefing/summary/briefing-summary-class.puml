@startuml briefing-summary-class
!include ../../_style/class.iuml
left to right direction
title Briefing > Summary — the most important published sentences, within 65 words

package "Client (React)" as Client {
    class BriefingPage {
        format
        + chooseFormat(value)
    }
    class BriefingFormat {
        format, onChange, label
    }
    class "formats.js" as formats {
        FORMATS, DEFAULT_FORMAT
        + keptFormat()
        + keepFormat(format)
        + fieldsOf(item, 'digest')
    }
    class BriefingCard {
        item, format
        Digest
    }
    class MailBar {
        way
        + send()
    }
    class BriefingApi {
        + getLatest()
        + email(..., format, ai)
    }
}
note right of formats
    The way chosen kept in
    localStorage under
    newsgenerator.briefing-format
end note
package "Business" {
    class briefingService {
        + readStories()
        + email()
    }
    class extract {
        + extractArticle()
        + shorterWays()
        + passagesText()
    }
    class briefingMail {
        MAIL_FORMATS
        + briefingMail()
        wayOf()
        digestHtml()
    }
}
note right of extract
    digest: the sentences the AI picked,
    the most important first, kept while
    they fit 65 words (the first always),
    back in the order of the article.
    Its translation is the one of the
    key passages, sentence by sentence
end note
class "PostgreSQL\nbriefings.items\n(digest, digestTranslation)" as DB <<external>>

BriefingPage --> BriefingFormat
BriefingPage --> formats
BriefingPage --> BriefingCard
BriefingPage --> MailBar
BriefingCard --> formats
MailBar --> BriefingFormat : "In the e-mail, as"
BriefingPage --> BriefingApi
BriefingApi --> briefingService : GET /briefing\nPOST /briefing/:id/email
briefingService --> extract : step "summarizing"
briefingService --> briefingMail
briefingService --> DB
@enduml
