@startuml briefing-summary-ia-class
!include ../../../_style/class.iuml
left to right direction
title Briefing > Summary > Summary (IA) — written by deepseek-v4-pro, shown on demand

package "Client (React)" as Client {
    class BriefingCard {
        item.ai, format 'digest'
        showAi
        AiVersion
    }
    class MailBar {
        inAi
        aiTextOf(story, 'digest')
        + send()
    }
    class BriefingApi {
        + getLatest()
        + email(..., format, ai)
    }
}
package "Business" {
    class briefingService {
        + readStories()
        + importedCard()
        + email()
    }
    class aiWays {
        WRITE_MODEL
        + aiWaysOf()
        + summaryPrompt()
        RULES()
        unnumbered()
        figuresFrom()
    }
    class extract {
        + sentencesOf()
        + figuresOf()
    }
    class language {
        + writtenIn()
    }
    class ollama {
        + ollamaJson(prompt, usage, {model, think})
    }
    class briefingMail {
        + briefingMail()
        wayOf()
    }
}
note right of aiWays
    One paragraph, 65 words at most, in the
    reader's language, from the same sentences
    as the key passages; 10 rules (no cause,
    certainty, place the article does not give).
    Left out when it holds a figure that is not
    in the title or the sentences
end note
note right of ollama
    A call naming its own model never goes
    to Gemini: busy, it waits 2, 5, 10, 20,
    30 s, then fails; the card keeps its
    published sentences
end note
class "Ollama cloud\n(deepseek-v4-pro:0813)" as Cloud <<external>>
class "PostgreSQL\nbriefings.items (ai)" as DB <<external>>

BriefingCard ..> BriefingApi
MailBar ..> BriefingApi
BriefingApi --> briefingService : GET /briefing\nPOST /briefing/:id/email
briefingService --> aiWays : step "summarizing"
aiWays --> extract
aiWays --> language
aiWays --> ollama
ollama --> Cloud
briefingService --> briefingMail : the cards of 'ai'
briefingService --> DB
@enduml
