@startuml
title Sauvegarde et récupération de l'historique (Backend)
autonumber

participant "Client (App)" as Client
participant "Router" as Router
participant "Controller" as Controller
participant "Service" as Service
participant "Model" as Model
database "Storage (DB)" as Storage

== Sauvegarde de la recherche personnalisée ==
Client -> Router : POST /customsearch (data)
Router -> Controller : processRequest(data)
Controller -> Service : saveUserCustomSearch(data)
Service -> Model : saveUserCustomSearch(data)
Model -> Storage : INSERT INTO custom_searches
Storage --> Model : confirm_success
Model --> Service : confirm_success
Service --> Controller : confirm_success
Controller --> Router : HTTP 200
Router --> Client : Response JSON (confirmation)

== Récupération de la recherche personnalisée ==
Client -> Router : GET /customsearch (user_id)
Router -> Controller : getUserCustomSearch(user_id)
Controller -> Service : getUserCustomSearch(user_id)
Service -> Model : getUserCustomSearch(user_id)
Model -> Storage : SELECT * FROM custom_searches
Storage --> Model : data_results
Model --> Service : data_results
Service --> Controller : data_results
Controller --> Router : HTTP 200 (OK)
Router --> Client : Response JSON (custom_search_data)

== Modification de la recherche personnalisée ==
Client -> Router : POST /customsearch (data)
Router -> Controller : processRequest(data)
Controller -> Service : postPutUserCustomSearch(data)
Service -> Model : (si mise à jour) updateUserCustomSearch(data)
Model -> Storage : UPDATE custom_searches
Service -> Model : (si création) postUserCustomSearch(data)
Model -> Storage : INSERT INTO custom_searches
Storage --> Model : confirm_success
Model --> Service : confirm_success
Service --> Controller : confirm_success
Controller --> Router : HTTP 200
Router --> Client : Response JSON (confirmation)

== Suppression de la recherche personnalisée ==
Client -> Router : DELETE /customsearch (search_id)
Router -> Controller : processRequest(search_id)
Controller -> Service : deleteUserCustomSearch(search_id)
Service -> Model : deleteUserCustomSearch(search_id)
Model -> Storage : DELETE custom_searches
Storage --> Model : confirm_success
Model --> Service : confirm_success
Service --> Controller : confirm_success
Controller --> Router : HTTP 200
Router --> Client : Response JSON (confirmation)

@enduml