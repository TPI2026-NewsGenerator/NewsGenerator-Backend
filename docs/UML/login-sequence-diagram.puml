@startuml
title Connexion de l'utilisateur (Backend)
autonumber

participant "Client (App)" as Client
participant "Router" as Router
participant "Controller" as Controller
participant "Service" as Service
participant "Model" as Model
database "Storage (DB)" as Storage

Client -> Router : POST /login (username, password)
Router -> Controller : authUser(req)
alt nom ou mot de passe vide
    Controller --> Client : HTTP 400
end
Controller -> Service : authUser(username, password)
Service -> Model : getUserByUsername(username)
Model -> Storage : findFirst(username)
Storage --> Model : user_data
Model --> Service : user_data
alt utilisateur inconnu
    Service --> Controller : 404
    Controller --> Client : HTTP 404
end
Service -> Service : verifyPassword() (bcrypt)
alt mot de passe faux
    Service --> Controller : 401
    Controller --> Client : HTTP 401
end
Service -> Service : generateAccessToken() (JWT)
Service --> Controller : {id_user, token}
Controller --> Client : HTTP 200 {id_user, token}

@enduml
