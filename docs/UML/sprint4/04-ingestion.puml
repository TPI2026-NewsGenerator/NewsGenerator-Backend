taggingService --> mentionModel
taggingService --> tagger
taggingService --> mentions
taggingService --> language
taggingService --> wikidata

googleNews --> crawlers
googleNews --> GoogleNewsApi
crawlers --> Sites
embedder --> Embedder
tagger --> Ner
wikidata --> Wikidata
feedDirectory --> Feedly

feedModel --> PostgreSQL
storyModel --> PostgreSQL
directoryModel --> PostgreSQL
mentionModel --> PostgreSQL
profileModel --> PostgreSQL
@enduml
