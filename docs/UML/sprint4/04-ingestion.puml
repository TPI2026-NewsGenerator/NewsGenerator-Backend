@startuml 04-ingestion
!include _style.iuml
left to right direction
title Ingestion — the cache filled in background

class "server.js" as serverStart {
    + IngestService.schedule()
    + TaggingService.schedule()
}
note bottom of serverStart
    "pnpm run ingest" (scripts/ingest.js) makes
    one run by hand. INGEST_IN_SERVER=false
    starts neither schedule: the runs are then
    left to "pnpm run ingest", nothing is tagged
end note

package "Business" {
    class ingestService {
        + schedule()
        + run()
        + readNow()
        + readEvery()
        + feedsDue()
        + threadPending()
    }
    class feedService {
        + refreshUrls()
        + syncCategories()
    }
    class directoryService {
        + grow()
        + prune()
        + chooseSections()
        + uselessFeeds()
        + sectionCategory()
    }
    class taggingService {
        + schedule()
        + tagBatch()
        + tagRows()
        + textOf()
    }
}
note top of ingestService
    Every minute, one run at a time (a lock of Postgres):
    the feeds due by their news of 24 h (every 2 to 60 min,
    once a day after 3 days failing), the Google News
    searches of the interests not read for an hour (60 at
    most), then batches of 100 news of the last 48 h
    embedded and grouped into stories and threads, for
    1 minute. Every 20 min the directory grows, once an
    hour the old news go, once a day the directory is pruned
end note
note bottom of feedService
    Not saved: a news published before the
    30 days kept, or one its feed gave already
    under another link (same title and date)
end note
note bottom of directoryService
    Every 20 min, 10 media of each kind: named
    by Google News and read by no feed (their
    main feed), or read already (the sections
    bringing what their feeds miss). Once a day
    the feeds of the directory serving no reader
    are taken out (directory_removed)
end note
note top of taggingService
    Its own loops, next to the runs: each tagger of
    NER_URL takes the newest news not tagged (16 at a
    time on a processor, 128 on a graphics card); the
    names met in 3 news or more are looked for in
    Wikidata, one every 7 s
end note

package "Data" {
    class "db/rss-links.js" as rssLinks {
        386 shared feeds
    }
    class feedModel {
        + feedRhythms()
        + dueFeeds()
        + allUserFeedUrls()
        + syncFeeds()
        + updateFeed()
        + withoutRepeats()
        + insertArticles()
        + deleteArticlesOlderThan()
        + busiestFeeds()
    }
    class storyModel {
        + pendingArticles()
        + pendingCount()
        + saveVectors()
        + assignStories()
        + assignThreads()
        + deleteEmptyStories()
    }
    class directoryModel {
        + all()
        + namedMedia()
        + triedSince()
        + mediaOfFeeds()
        + linksOf()
        + addFeeds()
        + tried()
        + stillRemoved()
        + readers()
        + usage()
        + remove()
    }
    class mentionModel {
        + untagged()
        + untaggedCount()
        + save()
        + toLink()
        + setLink()
        + deleteUnused()
    }
    class profileModel <<other feature>> {
        + searchesOf()
    }
}
note right of mentionModel
    save skips the news the grouping
    holds (SKIP LOCKED): tagged later
end note

package "utils" {
    class googleNews {
        + readSearches()
        + interestSearchUrls()
        + googleAvailable()
        + isGoogleNewsUrl()
    }
    class crawlers {
        + Xml()
    }
    class embedder {
        + embed()
        + toVector()
        + toSparsevec()
    }
    class language {
        + languageOf()
        + feedLanguage()
    }
    class dates {
        + toDate()
    }
    class feedLimits {
        + isFlood()
        + looksPrivate()
    }
    class feedFinder {
        + findFeeds()
        + siteFeeds()
        + readFeeds()
    }
    class feedDirectory {
        + searchDirectory()
    }
    class tagger {
        + taggerUrls()
        + taggerDevice()
        + tagTexts()
    }
    class mentions {
        + cleanMentions()
    }
    class wikidata {
        + exactItems()
    }
}

class "RSS feeds of the media\n(and RSS-Bridge)" as Sites <<external>>
class "Google News" as GoogleNewsApi <<external>>
class "Embedder bge-m3\n(embedder/server.py)" as Embedder <<external>>
class "Tagger GLiNER\n(ner/server.py)" as Ner <<external>>
class Wikidata <<external>>
class Feedly <<external>>
class "PostgreSQL + pgvector" as PostgreSQL <<external>>
note right of GoogleNewsApi
    One queue for every request of the server
    to Google. A blocked article page stops only
    the decoding of the links for an hour, a
    blocked search stops both
end note
note right of Embedder
    Every embedder of EMBEDDER_URL that
    answers takes batches at the same time
end note
note right of Ner
    Every tagger of NER_URL that answers
    takes its own news
end note

