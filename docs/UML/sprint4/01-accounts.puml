@startuml 01-accounts
!include _style.iuml
title Accounts — log in, sign up, the session and the settings

class EndUser
package "Presentation" {
    class loginRouter
    class signupRouter
    class sessionRouter {
        + GET /session
        + DELETE /session
    }
    class accountRouter {
        + PUT /account/username
        + PUT /account/password
    }
    class loginController {
        + authUser()
    }
    class signupController {
        + register()
    }
    class accountController {
        + rename()
        + changePassword()
    }
}
package "Business" {
    class loginService {
        + authUser()
    }
    class signupService {
        + register()
    }
    class accountService {
        + rename()
        + changePassword()
    }
    class profileService <<other feature>> {
        + prepare()
        + store()
    }
}
note right of signupService
    The account and its profile in one
    call: when the profile cannot be
    stored, the account is deleted again
end note
note left of accountService
    Each change asks the current password;
    the session starts again with the account
end note
package "Data" {
    class loginModel {
        + getUserByUsername()
    }
    class userModel {
        + taken()
        + roleId()
        + create()
        + delete()
        + nameTakenByOther()
        + withPassword()
        + passwordChangedAt()
        + update()
    }
}
package "utils" {
    class pwdHasher {
        + hashWithSalt()
        + verifyPassword()
    }
    class jwt {
        + generateAccessToken()
        + startSession()
        + endSession()
        + authenticateToken()
    }
    class rateLimit {
        + rateLimit()
    }
    class passwordChanges {
        + passwordChangedAt()
        + notePasswordChange()
    }
    class accountRules {
        + isUsername()
        + isPassword()
    }
}
note right of jwt
    The token is set in an HttpOnly cookie
    (SameSite=Strict, Secure through https),
    never answered to the page: 7 days,
    renewed once a day while used; one opened
    before the last change of password is
    refused (passwordChanges)
end note
class bcrypt <<external>>
class JsonWebToken <<external>>
class Prisma <<external>>

EndUser --> loginRouter
EndUser --> signupRouter
EndUser --> sessionRouter
EndUser --> accountRouter
accountRouter --> jwt
accountRouter --> rateLimit
accountRouter --> accountController
accountController --> accountService
accountController --> jwt
accountService --> userModel
accountService --> pwdHasher
accountService --> accountRules
accountService --> jwt
signupService --> accountRules
accountService --> passwordChanges
jwt --> passwordChanges
passwordChanges --> userModel
loginRouter --> rateLimit
loginRouter --> loginController
sessionRouter --> jwt
signupRouter --> rateLimit
signupRouter --> signupController
loginController --> loginService
loginController --> jwt
signupController --> signupService
signupController --> jwt
loginService --> loginModel
loginService --> pwdHasher
loginService --> jwt
signupService --> userModel
signupService --> profileService
signupService --> pwdHasher
signupService --> jwt
pwdHasher --> bcrypt
jwt --> JsonWebToken
loginModel --> Prisma
userModel --> Prisma
@enduml
