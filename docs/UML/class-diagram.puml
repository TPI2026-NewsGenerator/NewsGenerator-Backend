@startuml

title Class Diagram - Backend

left to right direction

package "Presentation Layer" {
    class router
    class loginRouter
    class newsRouter
    class custom_searchRouter
    class user_preferencesRouter
    class newsController
    class loginController
    class custom_searchController
    class user_preferencesController
}

package "Business Layer" {
    class newsService
    class loginService
    class custom_searchService
    class user_preferencesService
    class loginModel
    class custom_searchModel
    class user_preferencesModel
    class links
    class scraper
    class filter
    class jwt
    class pwdHasher
}

package "Infrastructure Layer" {
    class "Input/Output" as io
    class BasicCrawler
    class CheerioCrawler
    class JSONWebToken
    class bcrypt
}

