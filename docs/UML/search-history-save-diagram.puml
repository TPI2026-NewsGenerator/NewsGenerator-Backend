@startuml
title Sauvegarde de la recherche personnalisée (Backend)
autonumber

participant "Client (App)" as Client
participant "Router" as Router
participant "Controller" as Controller
participant "Service" as Service
participant "Model" as Model
database "Storage (DB)" as Storage

Client -> Router : POST /customsearch (title, keyword, language, category, sans id)
Router -> Router : authenticateToken()
Router -> Controller : postUserCustomSearch(req)
alt titre, mots, langue ou catégorie manquant
    Controller --> Client : HTTP 400
end
Controller -> Service : postPutUserCustomSearch(data, userId du token)
Service -> Model : postUserCustomSearch(userId, data)
Model -> Storage : INSERT custom_searches\n+ custom_searches_has_categories
Storage --> Model : la recherche créée
Model --> Service : la recherche créée
Service --> Controller : la recherche créée
Controller --> Client : HTTP 200 (la recherche)

@enduml
