@startuml
title Suppression de la recherche personnalisée (Backend)
autonumber

participant "Client (App)" as Client
participant "Router" as Router
participant "Controller" as Controller
participant "Service" as Service
participant "Model" as Model
database "Storage (DB)" as Storage


Client -> Router : DELETE /customsearch (id)
Router -> Router : authenticateToken()
Router -> Controller : deleteUserCustomSearch(req)
alt id manquant
    Controller --> Client : HTTP 400
end
Controller -> Service : deleteUserCustomSearch(id, userId du token)
Service -> Model : deleteUserCustomSearch(id, userId)
Model -> Storage : transaction : DELETE custom_searches_has_categories,\npuis DELETE custom_searches WHERE id et id_user
alt aucune recherche de cet utilisateur avec cet id
    Storage --> Model : erreur Prisma (P2025), rien n'est supprimé
    Model --> Service : P2025
    Service --> Controller : 404
    Controller --> Client : HTTP 404
end
Storage --> Model : confirm_success
Model --> Service : confirm_success
Service --> Controller : confirm_success
Controller --> Client : HTTP 200 {deleted: true}

@enduml
