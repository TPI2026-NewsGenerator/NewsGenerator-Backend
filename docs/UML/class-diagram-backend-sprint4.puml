

@startuml Class Diagram - Backend Sprint 4

skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

class EndUser

package "Presentation Layer" {
    class router {
        + use(/login, /signup, /news, /feeds, /customsearch, /profile, /briefing)
    }

    class loginRouter
    class signupRouter
    class newsRouter
    class feedRouter
    class customSearchRouter
    class profileRouter
    class briefingRouter

    class loginController {
        + authUser()
    }
    class signupController {
        + register()
    }
    class newsController {
        + getNews()
        + getCategories()
        + getNewsContent()
        + getNewsSummary()
    }
    class feedController {
        + getUserFeeds()
        + addUserFeed()
        + updateUserFeed()
        + deleteUserFeed()
        + suggestSources()
        + searchSources()
        + importSources()
        + getRecommended()
        + addRecommended()
    }
    class customSearchController {
        + getUserCustomSearch()
        + postUserCustomSearch()
        + deleteUserCustomSearch()
    }
    class profileController {
        + get()
        + options()
        + save()
        + updateInterest()
        + deleteInterest()
        + rediscover()
        + keepSource()
    }
    class briefingController {
        + latest()
        + start()
        + vote()
    }
}

package "Business Layer" {
    class loginService {
        + authUser()
    }
    class signupService {
        + register()
    }
    class customSearchService {
        + getUserCustomSearch()
        + postPutUserCustomSearch()
        + deleteUserCustomSearch()
    }

    class newsService {
        + getNews()
        + searchByMeaning()
        + cachedArticles()
        + getNewsContent()
        + summarizeStories()
    }
    note right of newsService
        Words: keyword SQL on the cache.
        A sentence: the closest news by
        their vectors, sorted by the AI.
        Cards grouped by story, then by
        thread. Answers how many media and
        how many wordings, never a verdict.
    end note

    class feedService {
        + refreshUrls()
        + languages()
        + categories()
        + syncCategories()
    }
    class ingestService {
        + run()
        + schedule()
    }
    note right of ingestService
        In background: reads the feeds and
        the Google News searches of the
        interests, embeds the news, groups
        them into stories and threads (SQL)
    end note

    class sourceService {
        + knownMedia()
        + searchDirectory()
        + searchWeb()
        + suggest()
    }
    class profileService {
        + topics()
        + get()
        + prepare()
        + store()
        + save()
        + updateInterest()
        + deleteInterest()
        + rediscover()
        + keepSource()
    }
    class discoveryService {
        + start()
        + isRunning()
    }
    class briefingService {
        + latest()
        + start()
        + vote()
    }
    note right of briefingService
        Stories ranked in SQL on the
        interests, chosen and checked by
        the AI, told by several media
    end note
    class feedbackService {
        + of()
        + refusedSources()
        + keep()
    }
    class recommendationService {
        + list()
        + add()
    }
}

package "Data Layer" {
    class loginModel {
        + getUserByUsername()
    }
    class userModel {
        + taken()
        + roleId()
        + create()
        + delete()
    }
    class customSearchModel
    class feedModel {
        + searchArticles()
        + closestArticles()
        + threadArticles()
        + insertArticles()
        + dueFeeds()
        + userFeedUrls()
        + addUserFeed()
        + recommendedFeeds()
        + saveExtract()
        + deleteArticlesOlderThan()
    }
    class storyModel {
        + pendingArticles()
        + saveVectors()
        + assignStories()
        + assignThreads()
        + rank()
        + storyArticles()
    }
    class profileModel {
        + get()
        + interests()
        + save()
        + setDiscovery()
        + addProfileFeeds()
        + profileFeedRelevance()
    }
    class briefingModel {
        + create()
        + finish()
        + latest()
        + vote()
        + votes()
    }
}

package "utils" {
    package "search" {
        class filter {
            + parse()
            + keywordsSql()
            + hasOperators()
        }
        class searchAi {
            + sortByMeaning()
        }
        class grouping {
            + unionFind()
            + averageLink()
        }
        class corroboration {
            + corroborationOf()
        }
        class hedging {
            + hedgedBy()
        }
        class readingOrder {
            + readingOrder()
        }
        class extract {
            + extractArticle()
            + translationFor()
        }
    }

    package "sources" {
        class feedFinder {
            + findFeeds()
            + isOnSubject()
            + isCommentsFeed()
        }
        class siteSections {
            + sectionLinks()
            + keywordJudge()
            + subjectStats()
        }
        class meaningJudge {
            + judgeOf()
        }
        class feedDirectory {
            + searchDirectory()
        }
        class feedBridge {
            + bridgeFeed()
        }
        class googleNews {
            + search()
            + readSearches()
            + decodeLinks()
        }
        class gdelt {
            + mediaFor()
        }
        class allocation {
            + allocate()
            + tryPerLanguage()
        }
        class feedLimits {
            + withinBridgeRoom()
            + looksPrivate()
        }
        class feedback {
            + refusedSources()
            + examplesOf()
        }
    }

    package "AI and vectors" {
        class ollama {
            + ollamaJson()
        }
        class profileAi {
            + interestsOf()
            + selectStories()
            + reviewCards()
            + checkStories()
            + mergeStories()
        }
        class embedder {
            + embed()
            + embedderIsUp()
            + denseSimilarity()
        }
        class language {
            + languageOf()
            + feedLanguage()
        }
        class topics
    }

    package "web and security" {
        class crawlers {
            + Html()
            + Xml()
        }
        class parser
        class publicUrl {
            + assertPublicUrl()
            + fetchPublicUrl()
            + mediumOf()
            + isBridgeUrl()
        }
        class concurrency {
            + mapWithConcurrency()
        }
        class links
        class dates
        class jwt {
            + generateAccessToken()
            + authenticateToken()
        }
        class pwdHasher {
            + hashWithSalt()
            + verifyPassword()
        }
        class rateLimit {
            + rateLimit()
        }
    }
}

package "Infrastructure Layer" {
    class bcrypt
    class JsonWebToken
    class Prisma
    class "PostgreSQL + pgvector" as PostgreSQL
    class Crawlee
    class "Ollama (gemma4:31b)" as Ollama
    class "Embedder (bge-m3, Python)" as EmbedderServer
    class "Google News" as GoogleNewsApi
    class "GDELT DOC 2.0" as GdeltApi
    class "Feed directory" as DirectoryApi
    class "RSS-Bridge" as RssBridge
}

