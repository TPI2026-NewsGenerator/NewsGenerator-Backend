@startuml following-names-on-cards-class
!include ../../_style/class.iuml
left to right direction
title Following > Names on cards — who a card is about, its countries, and the rare names that find its affair

package "Client (React)" {
    class BriefingCard <<other feature>> {
        "Who it is about": item.names
        under its topic: item.countries
    }
    class "countries.js" as countriesJs {
        + countryNames(codes, {titles, languages})
    }
    class EntityApi {
        + pageOf({name, qid})
    }
}
note bottom of EntityApi
    a qid: /following/:qid,
    else /following/name/:name
end note

package "Business" {
    class briefingService <<other feature>> {
        + write(briefingId, profileId, hours)
        + angleCardsOf(stories, titles, options)
    }
}

package "utils" {
    class cardNames {
        + namesOfCards(cards)
        + namesAndCountriesOfCards(cards)
        + withSurnamesLinked(names, rows)
        + cardNames(rows, articles, {media})
        + writtenAsName(name)
        + shortName(label, names)
        - chosenNames(rows, articles, options)
        - asOne(items, weight)
        - sameName(longer, shorter)
    }
    class nameCheck {
        + withNamesChecked(read, cards, {usage})
        + withNamesLinked(read, cards, {usage})
        + checkPrompt(options)
        + linkPrompt(options)
        + countriesOfSites(sites)
    }
    class affairNames {
        + storiesOfSameNames(stories, options)
        - linkNow(rows, budget)
    }
    class mentions {
        + mentionKey(name)
        + rareNames(rows, {rare, max})
    }
    class wikidata {
        + exactItems(name, language)
        + readCountries(qids)
    }
    class countries {
        + cardCountries(items, of)
        + countriesOfItems(qids)
    }
    class countryNames {
        + countryNamed(name)
        + countryNames(codes, options)
    }
    class briefingMail <<other feature>>
}
note bottom of countries
    who and where the card names vote, by its
    articles naming them: a person by the country
    it plays for or its citizenship, a body or place
    by its country, a country by its name; none for
    an international body, nor its people (FIFA,
    Infantino). Half the first at least, 3 at most
end note
note bottom of cardNames
    4 names a card at most, no place: named by a
    quarter of its articles at least, by 3 news or 2
    of the card (or linked to an item), written as a
    name, one writing per name, never an agency
    nor the medium itself
end note
note bottom of nameCheck
    A name is linked once for all its news, so its
    item may not be the card's. Checked: the AI
    reads the titles, the topic, the other names and
    the countries of the sites, for each item in 60
    Wikipedias or fewer; "no" leaves the link out.
    Chosen: a name with no item picks among the
    candidates kept for it (a person in 2 Wikipedias
    at least), 60 names a briefing at most
end note
note bottom of affairNames
    4 rare names a card: a person or body named
    by 400 news a month at most, beyond the card;
    6 linked to Wikidata now at most; the stories
    of 30 days naming them, 0.45 close at least
end note

package "Data" {
    class mentionModel {
        + namesOfArticles(articleIds, upTo)
        + want({ids})
        + candidatesOf(ids)
        + setLink(id, qid)
        + storiesNaming(options)
        + countriesOf(qids)
        + saveCountries(countries)
    }
    class "mentions" as mentionsTable <<table>> {
        name, kind, qid, linked_at, wanted_at
        candidates
    }
    class "article_mentions" as am <<table>>
    class "briefings" as briefings <<table>> {
        items[].names [{name, qid, kind}]
        items[].countries ["ZM", ...]
    }
    class "item_countries" as itemCountries <<table>> {
        qid, country, international, bodies
    }
}

class "Wikidata API" as WikidataApi <<external>>
class "Ollama (gemma4:31b)" as Ollama <<external>>

BriefingCard --> EntityApi
BriefingCard --> countriesJs
briefingService --> cardNames : namesAndCountriesOfCards()
briefingMail --> countryNames
cardNames --> countries
cardNames --> nameCheck
nameCheck --> wikidata
nameCheck --> mentionModel
nameCheck --> Ollama
cardNames --> countryNames
countries --> wikidata
countries --> mentionModel
briefingService --> affairNames : storiesOfSameNames()
briefingService --> briefings
cardNames --> mentions
cardNames --> mentionModel
affairNames --> mentions
affairNames --> wikidata
affairNames --> mentionModel
wikidata --> WikidataApi
mentionModel --> mentionsTable
mentionModel --> am
mentionModel --> itemCountries
@enduml
