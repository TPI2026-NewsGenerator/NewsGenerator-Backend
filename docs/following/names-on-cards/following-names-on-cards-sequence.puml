@startuml following-names-on-cards-sequence
!include ../../_style/sequence.iuml
title Following > Names on cards — the names and countries written on the cards of a briefing

actor Reader
participant "BriefingPage\nBriefingCard" as Client
participant briefingService as Briefing
participant cardNames as CardNames
participant nameCheck as Check
participant "Ollama\n(gemma4:31b)" as AI
participant affairNames as Affair
participant countries as Countries
participant wikidata as Wiki
participant "Wikipedia API\n(search)" as WikipediaApi
participant mentionModel as Model
database "PostgreSQL" as DB

Reader -> Client : makes a briefing
Client -> Briefing : POST /api/briefing -> write() in background
Briefing -> Briefing : the stories chosen and read (see Briefing)

== step "angles": together, none can fail the briefing ==
par the other angles
    Briefing -> Affair : storiesOfSameNames(stories, {30 days, excluded, 13})
    loop each card, 5 at a time
        Affair -> Model : namesOfArticles(its news, 401)
        Affair -> Affair : rareNames: no place, 400 news a month at most,\nnamed beyond the card, 4 at most
        opt names never looked for (6 a briefing at most)
            Affair -> Wiki : exactItems(name, lang)
            Affair -> Model : setLink(id, qid or null)
            note right : refused or down: the background links it later
        end
        Affair -> Model : storiesNaming(names, their qids, feeds,\n30 days, likeness >= 0.45 to the card)
    end
    Affair --> Briefing : Map storyId -> stories naming them
    note right of Briefing : added to the closest stories, judged by\nthe AI (see Briefing > Other angles)
else the names of the cards
    Briefing -> CardNames : namesAndCountriesOfCards([{storyId, ids, media, titles, sites, topic}])
    loop each card
        CardNames -> Model : namesOfArticles(ids, 3)
        Model -> DB : article_mentions of its news: inCard,\nand the news naming each (up to 3)
        CardNames -> CardNames : chosenNames: no place; qid, or 3 news,\nor 2 of the card; writtenAsName; no agency,\nno medium of the card
        CardNames -> CardNames : asOne: one writing per name\n("Infantino" = "Gianni Infantino", "PSG")
        CardNames -> CardNames : a quarter of its articles at least, 4 at most
        CardNames -> CardNames : its places with an item, and the countries\nnamed by their name (countryNamed)
    end
    CardNames -> Check : withNamesChecked(read, cards)
    Check -> Wiki : describeItems(qids): the items in 60 Wikipedias or fewer
    loop each of them, 4 at once
        Check -> AI : checkPrompt: titles of the card, its topic, its other names,\ncountries of its sites, the item (label, description, country)
        AI --> Check : same: yes, no or unsure
    end
    note right of Check : "no": the link is left out of the card\nand of its countries; an error leaves it
    CardNames -> Check : withNamesLinked(read, cards)
    Check -> Model : candidatesOf(ids of the persons in full and\norganisations shown with no qid)
    opt a name the check sent away, 10 a briefing at most
        Check -> Check : expansionOf(name, text of the card):\n"Fédération malgache de football (FMF)"
        Check -> Wiki : exactItems(that name, language of the lead)
        Check -> WikipediaApi : searchedItems("FMF Madagascar"):\nthe name and the main country of the sites
        note right of Check : candidates: these items, the stored ones,\nnever the item the check refused
    end
    Check -> Wiki : describeItems(their candidates, 10 at most)
    loop each name, 60 a briefing at most
        Check -> AI : linkPrompt: titles, topic, other names, countries\nof its sites, the candidates
        AI --> Check : n: the item of the name on this card, 0 for none
    end
    note right of Check : a person only in 2 Wikipedias at least\n(PERSON_LEAST); an error leaves it as it was
    CardNames -> Model : want({ids of the names without a qid})
    Model -> DB : mentions.wanted_at = now():\nfirst in the queue of Wikidata
    CardNames -> Countries : countriesOfItems(qids of its names and places;\na family name alone only for someone in 100 news)
    Countries -> Model : countriesOf(qids)
    Model -> DB : item_countries
    opt never read
        Countries -> Wiki : readCountries(40 at a time)
        note right : a pause asked: waited for, 30 s at most;\nthen the ones read so far
        Countries -> Model : saveCountries
    end
    CardNames -> Countries : cardCountries: weighed by its articles,\nhalf the first at least, 3 at most; no people's\ncountry when it names an international body
    CardNames --> Briefing : Map storyId -> {names: [{name, qid, kind}], countries}
end
alt failed
    Briefing -> Briefing : logged, the cards without names
end
Briefing -> DB : briefings.items[].names, items[].countries

== read ==
Client -> Briefing : GET /api/briefing
Briefing --> Client : the cards with their names
Client --> Reader : "Who it is about", each name a link (pageOf);\nits countries under its topic, none when the title names them
Reader -> Client : clicks a name
alt it has a qid
    Client -> Client : /following/:qid (see Wikidata items)
else
    Client -> Client : /following/name/:name (see Names and words)
end
@enduml
