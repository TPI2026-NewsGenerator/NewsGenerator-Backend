@startuml ingestion-names-class
!include ../../_style/class.iuml
left to right direction
title Ingestion > Names — the people, organisations and places of each news, and their item of Wikidata

class "server.js" as serverStart {
    + TaggingService.schedule()
}
note bottom of serverStart
    Not started with INGEST_IN_SERVER=false,
    nor without NER_URL: nothing is tagged
end note

package "Business" {
    class taggingService {
        + schedule()
        + tagBatch(url, device)
        + tagRows(url, rows)
        + textOf(row)
        - work(url)
        - link()
        - locate()
        - report()
        - housekeeping()
    }
}
note top of taggingService
    One loop per tagger of NER_URL: 16 news a batch on a
    processor, 128 on a graphics card, the newest of 30
    days first, none taken by another; idle or down:
    asked again after 60 s. One loop links the names met
    in 3 news or more, 50 a batch (the persons in full and
    the places by the title of their article, at once; the
    others at 150 calls a minute, the persons of one word last); one reads the country
    of the items linked, 40 a minute (maxlag 10). A report
    every hour, the unused names deleted once a day
end note

package "utils" {
    class tagger {
        + taggerUrls()
        + taggerDevice(url)
        + tagTexts(url, texts)
    }
    class mentions {
        + mentionKey(name)
        + cleanMentions(entities)
        + acronymsOf(name)
    }
    class language {
        + languageOf(text)
    }
    class wikidata {
        + exactItems(name, language)
        + famousHuman(qids)
        + placeItem(name, language)
        + famousPlace(qids)
        + namedItems(name, language)
        + describeItems(qids)
        + readCountries(qids, {background})
    }
    class countryNames {
        + countryNamed(name)
        + mediaOf(sites)
        + ofOtherCountry(sites, country)
    }
    class countries {
        + countriesOfItems(qids, {background})
    }
    class organizationItems {
        + organizationItem(mention, usage, candidates)
    }
    class personItems {
        + personItem(mention, qid, usage)
        + familyName(name)
    }
    class titleLinks {
        + linkedByTitle(rows)
        + articlesOf(rows)
    }
}
note bottom of mentions
    key: small letters, no accent, no quote,
    no "'s", no leading article; 120 characters
    at most; "UEFA" of "UEFA Nations League"
    added as an organisation
end note
note bottom of wikidata
    A 429, or "too busy": nothing asked by
    the process for Retry-After or 30 s.
    famousHuman: the human of several items
    far more known (sitelinks) than the others.
    placeItem: a country the item of its code
    (haswbstatement:P297); else the items called
    so by any name or alias, of several the place
    (P625) far more known (famousPlace)
end note
note bottom of countryNames
    "Espagne", "la France", "España", "US":
    the code of the country, in 37 languages
    (Intl.DisplayNames)
end note
note bottom of organizationItems
    The one item called so when it may be a body
    (no human, place nor work, 2 Wikipedias) and
    the sites naming it are not of another country,
    else the one the AI chooses from 5 titles of its
    news among the items called so or starting so,
    no person, in 10 Wikipedias at least. The items
    found are kept for a name left with none
end note
note bottom of personItems
    The one item called so: a human in a Wikipedia
    at least, else the AI tells if the news fit it; a
    word alone only a human in 20 Wikipedias
end note
note bottom of titleLinks
    The persons in full and the places, 50 a call, by
    the title of an article of the Wikipedia of their
    language (redirects resolved): no page of
    homonyms, a human or a place, no common noun
end note

package "Data" {
    class mentionModel {
        + untagged({since, limit, taken})
        + untaggedCount(since)
        + save(tagged)
        + toLink({least, limit})
        + setLink(id, qid)
        + setCandidates(id, qids)
        + candidatesOf(ids)
        + sitesNaming(id)
        + personsEndingWith(words)
        + titlesNaming(id, limit)
        + toLocate(limit)
        + countriesOf(qids)
        + saveCountries(countries)
        + deleteUnused()
    }
    class "articles" as articlesTable <<table>> {
        entities_at
    }
    class "mentions" as mentionsTable <<table>> {
        key, kind, name, lang, seen
        qid, linked_at, wanted_at
        candidates
    }
    class "article_mentions" as amTable <<table>> {
        id_mention, id_article
    }
    class "item_countries" as countriesTable <<table>> {
        qid, country, international
        bodies, looked_at
    }
}
note bottom of mentionModel
    save: the news marked first, FOR UPDATE
    SKIP LOCKED (the grouping holds some),
    the names counted (seen) in the order of
    their key, in one transaction
end note

package "Readers of the names" {
    class entityService <<other feature>>
    class cardNames <<other feature>>
    class affairNames <<other feature>>
}

class "ner/server.py\nGLiNER multi v2.1" as Ner <<external>> {
    GET /health -> device
    POST /entities {texts} -> {entities}
}
note right of Ner
    person, organization, location;
    threshold 0.5; 1000 characters a text,
    256 texts a request at most
end note
class "Wikidata API\n(wbsearchentities, wbgetentities,\nsearch haswbstatement)" as WikidataApi <<external>>
class "Wikipedia API\n(action=query, redirects)" as WikipediaApi <<external>>

serverStart --> taggingService
taggingService --> tagger
taggingService --> mentions
taggingService --> language
taggingService --> wikidata
taggingService --> organizationItems
taggingService --> personItems
taggingService --> titleLinks
titleLinks --> wikidata
titleLinks --> mentionModel
personItems --> wikidata
taggingService --> countries
countries --> wikidata
countries --> mentionModel
wikidata --> countryNames
organizationItems --> wikidata
organizationItems --> mentionModel
taggingService --> mentionModel
tagger --> Ner
wikidata --> WikidataApi
titleLinks --> WikipediaApi
mentionModel --> articlesTable
mentionModel --> mentionsTable
mentionModel --> amTable
mentionModel --> countriesTable
entityService ..> mentionModel
cardNames ..> mentionModel
affairNames ..> mentionModel
@enduml
